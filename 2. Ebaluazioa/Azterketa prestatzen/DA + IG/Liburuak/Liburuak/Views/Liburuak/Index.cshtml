@model IEnumerable<Liburuak.ViewModels.LiburuaViewModel>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.saga)
            </th>
            <th>
                Año de publicación
            </th>
            <th>
                @Html.DisplayNameFor(model => model.paginas)
            </th>
            <th>
                Valoración promedio
            </th>
            <th>
                @Html.DisplayNameFor(model => model.sinopsis)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.titulo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.saga)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.anio_publicacion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.paginas)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.valoracion_promedio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.sinopsis)
            </td>
        </tr>
}
    </tbody>
</table>
